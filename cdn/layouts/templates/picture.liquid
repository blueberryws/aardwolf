  <picture
      data-attribution-href="{{picture.attribution_href}}"
      data-attribution-text="{{picture.attribution_text}}"
      data-editor="picture"
    >
    <source class="desktop" media="(min-width: 1400px)" srcset="https://twodollarwebsite.sfo3.digitaloceanspaces.com/twodollarwebsite/{{site_id}}/images/{{picture.uuid}}/desktop.avif">
    <source class="laptop" media="(min-width: 1200px)" srcset="https://twodollarwebsite.sfo3.digitaloceanspaces.com/twodollarwebsite/{{site_id}}/images/{{picture.uuid}}/laptop.avif">
    <source class="notebook" media="(min-width: 992px)" srcset="https://twodollarwebsite.sfo3.digitaloceanspaces.com/twodollarwebsite/{{site_id}}/images/{{picture.uuid}}/notebook.avif">
    <source class="tablet" media="(min-width: 768px)" srcset="https://twodollarwebsite.sfo3.digitaloceanspaces.com/twodollarwebsite/{{site_id}}/images/{{picture.uuid}}/tablet.avif">
    <source class="phone" media="(min-width: 576px)" srcset="https://twodollarwebsite.sfo3.digitaloceanspaces.com/twodollarwebsite/{{site_id}}/images/{{picture.uuid}}/phone.avif">
    <source class="x-small" media="(min-width: 1px)" srcset="https://twodollarwebsite.sfo3.digitaloceanspaces.com/twodollarwebsite/{{site_id}}/images/{{picture.uuid}}/x-small.avif">
    <img alt="{{picture.alt_text}}" src="https://twodollarwebsite.sfo3.digitaloceanspaces.com/twodollarwebsite/{{site_id}}/images/{{picture.uuid}}/default.png">
</picture>
